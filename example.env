# Personality is personality.txt. Ollama must already be running.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
PERSONALITY_FILE=personality.txt

# Local speech-to-text. No OpenAI key.
WHISPER_URL=http://127.0.0.1:8178

# Local Voicevox engine.
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=46
VOICEVOX_LOG=True

# Personality replies are Japanese, so Voicevox speaks them directly.
TRANSLATE_TO_JP=False

VOICE=voicevox

TTS_EN=False
TTS_JP=True

# On this Linux VM set VTUBE_STUDIO_ENABLED=False or the connect loop waits forever.
# The Windows copy stays True. VTube Studio API port is 8001.
VTUBE_STUDIO_ENABLED=True
VTUBE_STUDIO_API_PORT=8001

# cuda or cpu
TORCH_DEVICE=cpu
